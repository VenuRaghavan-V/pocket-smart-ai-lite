# -----------------------------------------------------------------------------
# Pocket Smart AI (LITE) - environment variable template
#
# The real .env file is git-ignored because it holds secrets.
# Recreate it locally with:  cp .env.example .env
# -----------------------------------------------------------------------------

# Groq API key - create one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model id used for chat completions
GROQ_MODEL=llama-3.3-70b-versatile

# Flask session signing key - use a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# True for local development, False in production
FLASK_DEBUG=False

# Maximum PDF upload size in MB.
# On Vercel set this to 4: Vercel caps request bodies at 4.5 MB.
MAX_UPLOAD_MB=16

# Optional: force where the SQLite DB / RAG index / uploads are written.
# Defaults to the project folder locally and to the OS temp dir on
# read-only serverless hosts (Vercel).
# POCKET_AI_STORAGE_DIR=/opt/render/project/src/storage
